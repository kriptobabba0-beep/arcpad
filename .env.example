# Arc testnet -- https://docs.arc.io/arc/references/connect-to-arc
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app

# Deploy imzalama. Ozel anahtar ASLA buraya veya argv'ye yazilmaz;
# sifreli keystore hesabi kullanilir:
#   cast wallet import arcpad-deployer --interactive
ARC_KEYSTORE_ACCOUNT=arcpad-deployer

# Adres defteri -> env.
#
# BU DEGERLER BILEREK BOS BIRAKILMISTIR VE OYLE KALMALIDIR. Dogruluk kaynagi
# contracts/deploy/addresses.<chainId>.json'dir; bunlar oradan URETILIR:
#
#   pnpm addressbook --chain 5042002
#
# komutu defteri yazar ve asagidaki blogu doldurulmus halde BASAR.
#
# Peki defter zaten commit'liyken env neden var? Next, `NEXT_PUBLIC_*`i BUILD
# ANINDA paketin icine gomer; istek aninda okunan bir JSON istemci paketine hic
# ulasmaz. Yani bu bir tercih degil, zorunluluk. Yarattigi risk -- taze deftere
# karsi bayat env -- `assertEnvMatchesBook` ile kapatilir; Faz 4'un
# `preflight`i onu besinci iddiasi olarak cagirir.
#
# Adresler buraya KOPYALANMAZ: kopyalansaydi "yapilandirilmamis" durumu
# ulasilamaz hale gelir ve preflight'in belgelenmis EXIT KODU 2'si olu kod
# olurdu.
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARCPAD_FACTORY=
NEXT_PUBLIC_ARCPAD_ESCROW=
ARC_FACTORY_ADDRESS=
ARC_ESCROW_ADDRESS=
ARC_START_BLOCK=

# Keeper
KEEPER_POLL_INTERVAL_MS=5000
KEEPER_DRY_RUN=true

# Graduation penceresi izleyicisi (docs/runbooks/graduation-window.md).
#
# IZLEYICI SALT OKURDUR ve `KEEPER_DRY_RUN` onu KAPATMAZ: hicbir islem
# yayinlamaz, dolayisiyla Safe'ler kurulmadan ve hedef atanmadan once de
# calisir -- calismasi da gerekir, cunku factory hicbir an izlenmeden canli
# olmamalidir. Factory adresini ve baslangic blogunu yukaridaki
# ARC_FACTORY_ADDRESS / ARC_START_BLOCK'tan okur.
#
# chainKey, addresses.<chainId>.json icindeki `chainKey` ile AYNI olmalidir;
# expected-governance.json'daki kaydi o secer. Kayit doldurulmamissa (treasury
# ya da governor sifir) izleyici BASLAMAYI REDDEDER -- doldurulmamis bir izin
# listesiyle her poll sayfa cikardigi icin rota bir gun icinde susturmayi
# ogrenir ve kontrol "calisiyor" gorunurken sifira duser.
KEEPER_CHAIN_KEY=arc-testnet
KEEPER_GOVERNANCE_FILE=contracts/deploy/expected-governance.json
# Launched taramasinin imleci. Yeniden baslatma genesis'ten taramasin diye.
KEEPER_CURSOR_FILE=keeper/.cursor
KEEPER_LOG_SCAN_CHUNK=10000
# Haftalik tatbikatin okudugu alarm lavabosu (`pnpm --filter @arcpad/keeper drill`).
KEEPER_ALERT_LOG=keeper/alerts.log
KEEPER_DRILL_TARGET=0x000000000000000000000000000000000000dEaD

# Postgres (Faz 3'te kullanilacak)
DATABASE_URL=postgres://arcpad:arcpad@localhost:5432/arcpad
