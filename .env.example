# Arc testnet -- https://docs.arc.io/arc/references/connect-to-arc
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app

# Deploy imzalama. Ozel anahtar ASLA buraya veya argv'ye yazilmaz;
# sifreli keystore hesabi kullanilir:
#   cast wallet import arcpad-deployer --interactive
ARC_KEYSTORE_ACCOUNT=arcpad-deployer

# Governance toreni (docs/runbooks/deploy.md).
#
# IKI SAFE ADRESI BURADA YOKTUR VE OLMAYACAKTIR. Dogruluk kaynagi
# contracts/deploy/expected-governance.json'dir ve o dosya derlenen bir
# digest'e baglidir (script/Profiles.sol icindeki ARC_TESTNET_GOVERNANCE_DIGEST):
# adresleri tek basina duzenlemek GovernanceDigestMismatch verir. Ayni
# adresleri buraya kopyalamak, hicbir sey tarafindan kontrol edilmeyen ucuncu
# bir kopya yaratirdi -- ve o kopya, digest'in var olma sebebi olan
# "veri dosyasini duzenleyip baska bir sey deploy etme" yolunu geri acardi.
#
# Her owner KENDI makinesinde kendi keystore hesabini tutar; asagidaki ad
# yalnizca runbook'un komutlariyla tutarli olsun diyedir. Uc owner'in da ayni
# ada sahip olmasi normaldir -- anahtarlar ayri makinelerdedir, ad degil.
ARC_OWNER_KEYSTORE_ACCOUNT=arcpad-owner

# Adres defteri -> env.
#
# BU DEGERLER BILEREK BOS BIRAKILMISTIR VE OYLE KALMALIDIR. Dogruluk kaynagi
# contracts/deploy/addresses.<chainId>.json'dir; bunlar oradan URETILIR:
#
#   pnpm addressbook --chain 5042002
#
# komutu defteri yazar ve asagidaki blogu doldurulmus halde BASAR.
#
# Peki defter zaten commit'liyken env neden var? Next, `NEXT_PUBLIC_*`i BUILD
# ANINDA paketin icine gomer; istek aninda okunan bir JSON istemci paketine hic
# ulasmaz. Yani bu bir tercih degil, zorunluluk. Yarattigi risk -- taze deftere
# karsi bayat env -- `assertEnvMatchesBook` ile kapatilir; Faz 4'un
# `preflight`i onu besinci iddiasi olarak cagirir.
#
# Adresler buraya KOPYALANMAZ: kopyalansaydi "yapilandirilmamis" durumu
# ulasilamaz hale gelir ve preflight'in belgelenmis EXIT KODU 2'si olu kod
# olurdu.
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARCPAD_FACTORY=
NEXT_PUBLIC_ARCPAD_ESCROW=
ARC_FACTORY_ADDRESS=
ARC_ESCROW_ADDRESS=
ARC_START_BLOCK=

# Keeper
KEEPER_POLL_INTERVAL_MS=5000
KEEPER_DRY_RUN=true

# Graduation penceresi izleyicisi (docs/runbooks/graduation-window.md).
#
# IZLEYICI SALT OKURDUR ve `KEEPER_DRY_RUN` onu KAPATMAZ: hicbir islem
# yayinlamaz, dolayisiyla Safe'ler kurulmadan ve hedef atanmadan once de
# calisir -- calismasi da gerekir, cunku factory hicbir an izlenmeden canli
# olmamalidir.
#
# FACTORY, START BLOCK VE CHAIN KEY BURADAN GELMEZ. Izleyici ucunu de
# contracts/deploy/addresses.<ARC_CHAIN_ID>.json'dan okur. Yukaridaki
# ARC_FACTORY_ADDRESS / ARC_START_BLOCK ve asagidaki KEEPER_CHAIN_KEY
# AYARLANIRSA defterle AYNI olmak ZORUNDADIR, aksi halde keeper alan adiyla
# durur. Sebep olculdu: ilk launch'in ilerisine ayarlanmis elle yazilmis bir
# startBlock, her poll sayfa cikarip hic kalp atisi vermeyen bir keeper
# uretiyordu -- bes saniyelik varsayilan aralikta gunde ~35.000 sayfa.
#
# Kayit doldurulmamissa (treasury ya da governor sifir) izleyici BASLAMAYI
# REDDEDER -- doldurulmamis bir izin listesiyle her poll sayfa cikardigi icin
# rota bir gun icinde susturmayi ogrenir ve kontrol "calisiyor" gorunurken
# sifira duser.
KEEPER_CHAIN_KEY=
KEEPER_GOVERNANCE_FILE=contracts/deploy/expected-governance.json
# Defterin dizini. URETIMDE BOS BIRAKIN -- varsayilan contracts/deploy dogru
# olandir. Staging defterlerine karsi kosmak ve izleyiciyi gercek bir surec
# olarak sahte bir zincire karsi kirabilmek icin vardir.
#
# BOS DIZE "ayarlanmamis" demektir ve oyle ele alinir. (Bir sure oyle ele
# ALINMIYORDU: bos dize `loadAddressBook(chainId, '')`e ciplak goreli yol
# olarak gidiyor ve bu satiri oldugu gibi birakan bir kurulum baslamayi
# reddeden bir keeper uretiyordu.)
#
# AYARLARSANIZ ARC_FACTORY_ADDRESS DE ZORUNLU OLUR ve defterle tutmak
# zorundadir. Sebep: bayat bir tatbikat dizini izleyiciyi BASKA, sessiz,
# gercek bir factory'ye baglar -- okumalar basarili olur, kalp atislari akar,
# her dedektor susar, ve onemli olan factory izlenmez. Ikinci ve daha guclu
# kapi zincirin kendisidir: keeper acilista factory'nin governor()'unu okur ve
# expected-governance.json ile karsilastirir.
KEEPER_ADDRESS_BOOK_DIR=
# Log taramasinin imleci. Yeniden baslatma genesis'ten taramasin diye.
KEEPER_CURSOR_FILE=keeper/.cursor
KEEPER_LOG_SCAN_CHUNK=10000

# ALARM LAVABOSU. Ayarliysa keeper HER olayi -- PAGE, OK ve HEARTBEAT --
# TEK bir dosyaya da yazar. Haftalik tatbikatin `observe` fazi tam olarak bu
# dosyayi okur, ve harici olu-adam anahtari HEARTBEAT satirlarini sayar.
#
# Kabuk yonlendirmesiyle URETMEYIN: `pnpm start > alerts.log` tam olarak PAGE
# satirlarini dusurur, cunku onlar stderr'e gider. Degiskeni ayarlayin, keeper
# birlestirmeyi kendi yapar.
KEEPER_ALERT_LOG=keeper/alerts.log
# Ayni bulgunun tekrar yayilma araligi (ms). Ilk sayfa ASLA bastirilmaz ve
# durum degisirse (farkli hedef) yeni sayfa ANINDA cikar. Varsayilan 1 saat.
KEEPER_ALERT_REPEAT_MS=3600000
KEEPER_DRILL_TARGET=0x000000000000000000000000000000000000dEaD
# Tatbikat penceresinin ACILDIGI an (ISO-8601). Safe oneriyi gondermeden HEMEN
# ONCE kaydedilir. ZORUNLUDUR ve varsayilani YOKTUR: bu olmadan tatbikat
# tarihin herhangi bir noktasindaki bir sayfayi kabul ederdi -- yani ilk
# basarili kosudan sonra, izleyici olse bile, sonsuza kadar yesil kalirdi.
KEEPER_DRILL_SINCE=

# Postgres (Faz 3'te kullanilacak)
DATABASE_URL=postgres://arcpad:arcpad@localhost:5432/arcpad
