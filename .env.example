# Arc testnet -- https://docs.arc.io/arc/references/connect-to-arc
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app

# Deploy imzalama. Ozel anahtar ASLA buraya veya argv'ye yazilmaz;
# sifreli keystore hesabi kullanilir:
#   cast wallet import arcpad-deployer --interactive
ARC_KEYSTORE_ACCOUNT=arcpad-deployer

# Governance toreni (docs/runbooks/deploy.md).
#
# IKI SAFE ADRESI BURADA YOKTUR VE OLMAYACAKTIR. Dogruluk kaynagi
# contracts/deploy/expected-governance.json'dir ve o dosya derlenen bir
# digest'e baglidir (script/Profiles.sol icindeki ARC_TESTNET_GOVERNANCE_DIGEST):
# adresleri tek basina duzenlemek GovernanceDigestMismatch verir. Ayni
# adresleri buraya kopyalamak, hicbir sey tarafindan kontrol edilmeyen ucuncu
# bir kopya yaratirdi -- ve o kopya, digest'in var olma sebebi olan
# "veri dosyasini duzenleyip baska bir sey deploy etme" yolunu geri acardi.
#
# Her owner KENDI makinesinde kendi keystore hesabini tutar; asagidaki ad
# yalnizca runbook'un komutlariyla tutarli olsun diyedir. Uc owner'in da ayni
# ada sahip olmasi normaldir -- anahtarlar ayri makinelerdedir, ad degil.
ARC_OWNER_KEYSTORE_ACCOUNT=arcpad-owner

# Adres defteri -> env.
#
# BU DEGERLER BILEREK BOS BIRAKILMISTIR VE OYLE KALMALIDIR. Dogruluk kaynagi
# contracts/deploy/addresses.<chainId>.json'dir; bunlar oradan URETILIR:
#
#   pnpm addressbook --chain 5042002
#
# komutu defteri yazar ve asagidaki blogu doldurulmus halde BASAR.
#
# Peki defter zaten commit'liyken env neden var? Next, `NEXT_PUBLIC_*`i BUILD
# ANINDA paketin icine gomer; istek aninda okunan bir JSON istemci paketine hic
# ulasmaz. Yani bu bir tercih degil, zorunluluk. Yarattigi risk -- taze deftere
# karsi bayat env -- `assertEnvMatchesBook` ile kapatilir; Faz 4'un
# `preflight`i onu besinci iddiasi olarak cagirir.
#
# Adresler buraya KOPYALANMAZ: kopyalansaydi "yapilandirilmamis" durumu
# ulasilamaz hale gelir ve preflight'in belgelenmis EXIT KODU 2'si olu kod
# olurdu.
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARCPAD_FACTORY=
NEXT_PUBLIC_ARCPAD_ESCROW=
# ISTEGE BAGLI VE BOS BIRAKILMASI NORMALDIR. Bos ise web, zincir KAYDINDAKI
# (packages/shared/src/chain.ts) RPC'yi kullanir. Doldurmak bir Arc hostunu
# ikinci kez yazmak demektir; yalnizca kendi node'unuza yonlendiriyorsaniz
# doldurun. http:/https: olmak zorundadir -- HTTP transport'u wss: ile hicbir
# seye baglanmaz ve hata cok sonra, anlamsiz bir fetch hatasi olarak cikar.
NEXT_PUBLIC_ARC_RPC_URL=
ARC_FACTORY_ADDRESS=
ARC_ESCROW_ADDRESS=
ARC_START_BLOCK=

# Keeper
KEEPER_POLL_INTERVAL_MS=5000
KEEPER_DRY_RUN=true

# Graduation penceresi izleyicisi (docs/runbooks/graduation-window.md).
#
# IZLEYICI SALT OKURDUR ve `KEEPER_DRY_RUN` onu KAPATMAZ: hicbir islem
# yayinlamaz, dolayisiyla Safe'ler kurulmadan ve hedef atanmadan once de
# calisir -- calismasi da gerekir, cunku factory hicbir an izlenmeden canli
# olmamalidir.
#
# FACTORY, START BLOCK VE CHAIN KEY BURADAN GELMEZ. Izleyici ucunu de
# contracts/deploy/addresses.<ARC_CHAIN_ID>.json'dan okur. Yukaridaki
# ARC_FACTORY_ADDRESS / ARC_START_BLOCK ve asagidaki KEEPER_CHAIN_KEY
# AYARLANIRSA defterle AYNI olmak ZORUNDADIR, aksi halde keeper alan adiyla
# durur. Sebep olculdu: ilk launch'in ilerisine ayarlanmis elle yazilmis bir
# startBlock, her poll sayfa cikarip hic kalp atisi vermeyen bir keeper
# uretiyordu -- bes saniyelik varsayilan aralikta gunde ~35.000 sayfa.
#
# Kayit doldurulmamissa (treasury ya da governor sifir) izleyici BASLAMAYI
# REDDEDER -- doldurulmamis bir izin listesiyle her poll sayfa cikardigi icin
# rota bir gun icinde susturmayi ogrenir ve kontrol "calisiyor" gorunurken
# sifira duser.
KEEPER_CHAIN_KEY=
# BU YOL CALISMA DIZININE GORELIDIR ve keeper'i depo kokunden BASKA bir yerden
# baslatirsaniz cozulmez. Bos birakmak DAHA GUVENLIDIR: bos dize "ayarlanmamis"
# demektir ve keeper commit'li varsayilani (repo kokune gore cozulmus
# contracts/deploy/expected-governance.json) kullanir. Yalnizca gercekten baska
# bir dosya istiyorsaniz doldurun, ve MUTLAK yol verin.
#
# NOT: KEEPER_ADDRESS_BOOK_DIR ayarliysa BU DEGISKEN AYARLANAMAZ. Ikisi birden
# ezilirse zincir pini env-secili bir defteri env-secili bir governance
# dosyasiyla karsilastirir ve hicbir sey ispatlamaz.
KEEPER_GOVERNANCE_FILE=
# Defterin dizini. URETIMDE BOS BIRAKIN -- varsayilan contracts/deploy dogru
# olandir. Staging defterlerine karsi kosmak ve izleyiciyi gercek bir surec
# olarak sahte bir zincire karsi kirabilmek icin vardir.
#
# BOS DIZE "ayarlanmamis" demektir ve oyle ele alinir. (Bir sure oyle ele
# ALINMIYORDU: bos dize `loadAddressBook(chainId, '')`e ciplak goreli yol
# olarak gidiyor ve bu satiri oldugu gibi birakan bir kurulum baslamayi
# reddeden bir keeper uretiyordu.)
#
# AYARLARSANIZ ARC_FACTORY_ADDRESS DE ZORUNLU OLUR ve defterle tutmak
# zorundadir. Sebep: bayat bir tatbikat dizini izleyiciyi BASKA, sessiz,
# gercek bir factory'ye baglar -- okumalar basarili olur, kalp atislari akar,
# her dedektor susar, ve onemli olan factory izlenmez. Ikinci ve daha guclu
# kapi zincirin kendisidir: keeper acilista factory'nin governor()'unu okur ve
# expected-governance.json ile karsilastirir.
KEEPER_ADDRESS_BOOK_DIR=
# Log taramasinin imleci. Yeniden baslatma genesis'ten taramasin diye.
KEEPER_CURSOR_FILE=keeper/.cursor
KEEPER_LOG_SCAN_CHUNK=10000

# ALARM LAVABOSU. Ayarliysa keeper HER olayi -- PAGE, OK ve HEARTBEAT --
# TEK bir dosyaya da yazar. Haftalik tatbikatin `observe` fazi tam olarak bu
# dosyayi okur, ve harici olu-adam anahtari HEARTBEAT satirlarini sayar.
#
# Kabuk yonlendirmesiyle URETMEYIN: `pnpm start > alerts.log` tam olarak PAGE
# satirlarini dusurur, cunku onlar stderr'e gider. Degiskeni ayarlayin, keeper
# birlestirmeyi kendi yapar.
KEEPER_ALERT_LOG=keeper/alerts.log
# Ayni bulgunun tekrar yayilma araligi (ms). Ilk sayfa ASLA bastirilmaz ve
# durum degisirse (farkli hedef) yeni sayfa ANINDA cikar. Varsayilan 1 saat.
KEEPER_ALERT_REPEAT_MS=3600000
KEEPER_DRILL_TARGET=0x000000000000000000000000000000000000dEaD
# Tatbikat penceresinin ACILDIGI an (ISO-8601). Safe oneriyi gondermeden HEMEN
# ONCE kaydedilir. ZORUNLUDUR ve varsayilani YOKTUR: bu olmadan tatbikat
# tarihin herhangi bir noktasindaki bir sayfayi kabul ederdi -- yani ilk
# basarili kosudan sonra, izleyici olse bile, sonsuza kadar yesil kalirdi.
KEEPER_DRILL_SINCE=

# ---------------------------------------------------------------
# GRADUATION YURUTUCUSU -- `pnpm --filter @arcpad/keeper graduate`
# ---------------------------------------------------------------
#
# AYRI BIR SUREÇTIR ve yukaridaki izleyiciyle degisken PAYLASMAZ (imlec, alarm
# dosyasi ve poll araligi ayri). Sebep: izleyici SALT OKURDUR ve hedef
# atanmadan once bile calisir; yurutucu ZINCIRE YAZAR. Ayni sureçte yasarlarsa
# tek imlece iki yazici girer ve tatbikatin canlilik kapisi yurutucunun kalp
# atislarini izleyicininki sanar.
#
# KURU KOSU VARSAYILANDIR. Yayin icin `KEEPER_DRY_RUN=false` VE bir imzalayan,
# IKISI BIRDEN gerekir; biri eksikse surec BASLAMAZ.
#
# OZEL ANAHTAR BU DOSYAYA YAZILMAZ. Surece disaridan enjekte edin:
#   KEEPER_DRY_RUN=false KEEPER_GRADUATE_PRIVATE_KEY=0x... \
#     pnpm --filter @arcpad/keeper graduate -- --once
KEEPER_GRADUATE_PRIVATE_KEY=
# Dongu modunda gecis araligi (ms). `--once` bu degeri turlar arasi bekleme
# olarak kullanir (en fazla 3 sn).
KEEPER_GRADUATE_POLL_INTERVAL_MS=15000
# Bir gecisde en fazla kac curve denenir.
KEEPER_GRADUATE_MAX_PER_PASS=4
# Gecis basina log parcasi butcesi. Varsayilan dongu modunda 1 (zinciri yurume
# isi indexer'indir), `--once` modunda 8. OLCULDU: ard arda 50 `eth_getLogs`
# canli Arc tarafindan `rate limit exceeded` ile reddedildi.
KEEPER_GRADUATE_CHUNKS_PER_PASS=
# Kendi imleci, kendi durumu, kendi kilitleri. Izleyicininkilerle AYNI OLAMAZ.
KEEPER_GRADUATE_CURSOR_FILE=keeper/.cursor-graduate
KEEPER_GRADUATE_STATE_FILE=keeper/.graduate-state.json
KEEPER_GRADUATE_LOCK_DIR=keeper/.graduate-locks
# Yurutucunun alarm lavabosu. `KEEPER_ALERT_LOG`dan AYRI olmalidir: tatbikat
# o dosyadaki kalp atislarini IZLEYICININ kaniti sayar.
KEEPER_GRADUATE_ALERT_LOG=keeper/graduate.log
#
# DEFTER DISI (disposable) BIR YIGINA KARSI KOSMAK. Adres defteri yalnizca
# kanonik CREATE2 adresindeki fabrikayi tasiyabilir, dolayisiyla disposable
# yigin oraya GIREMEZ. Uc degisken de BIRLIKTE verilir; guvence zincirden
# gelir (`locker.factory()` fabrikayla uyusmak zorundadir).
KEEPER_GRADUATE_FACTORY=
KEEPER_GRADUATE_LOCKER=
KEEPER_GRADUATE_START_BLOCK=
#
# ...VE UZUN SURELI SERVIS BU UC DEGISKENI KABUL ETMEZ. `--book-only` bayragi
# (bkz. keeper/deploy/arcpad-keeper-graduate.service) ucunden biri bile
# ortamdaysa BASLAMAZ. Bayrak ARGV'dedir, env'de DEGIL: env'de olsaydi ayni
# dosya hem kapiyi hem de kapinin engelledigi adresleri tasiyabilirdi.
# Yukaridaki blok elle calistirilan TEK SEFERLIK yordamlar icindir -- ve o
# yordam KEEPER_GRADUATE_CURSOR_FILE'i da AYRI vermelidir, aksi halde
# disposable yiginin kimligi uretim imlecinin uzerine yazilir.

# ANAHTARIN IKINCI YOLU: DOSYA. `KEEPER_GRADUATE_PRIVATE_KEY` ile BIRLIKTE
# verilemez (hangisinin kazandigi bir IMZALAYAN KIMLIGIDIR ve sessizce
# secilmemelidir). systemd'nin `LoadCredentialEncrypted=`i anahtari diskte
# sifreli tutup yalnizca unit'in kendi kimlik dizinine cozer, ve oraya bir
# DOSYA koyar -- yani bu degisken, anahtarin hicbir surecin ortaminda
# gorunmemesini mumkun kilan seydir.
KEEPER_GRADUATE_PRIVATE_KEY_FILE=

# ALARM LAVABOSUNU OKUYAN SUREC (keeper/src/notify.ts). Bilesen basina BIR
# ornek: iki bileseni tek bir olu-adam anahtarina pinglemek, yurutucunun
# check-in'lerinin OLU bir izleyiciyi saklamasi demektir. IKI URL DE
# ZORUNLUDUR; yalnizca biriyle surec BASLAMAZ, cunku bu kontrolun yarisi
# "kuruldu" diye kaydedilip diger yarinin arizasinda sessiz kalirdi.
KEEPER_NOTIFY_LOG=
KEEPER_NOTIFY_LABEL=
KEEPER_NOTIFY_PAGE_URL=
KEEPER_NOTIFY_HEARTBEAT_URL=

# Postgres (Faz 3'te kullanilacak)
DATABASE_URL=postgres://arcpad:arcpad@localhost:5432/arcpad

# =========================================================================
#  UCTAN UCA (Faz 4, Task 15). `web/playwright.config.ts`.
# =========================================================================
#
# YEREL AYAK ICIN HICBIR SEY GEREKMEZ. `pnpm --filter @arcpad/web e2e:local`
# kendi anvil'ini baslatir, kontratlari `contracts/out`tan deploy eder,
# adresleri `.env.e2e`ye yazar ve `next build && next start` kosar. Asagidaki
# butun degiskenler ARC AYAGI icindir.
#
# ARC AYAGI KAPILIDIR VE UC DURUMU DA SESSIZ DEGILDIR:
#   E2E_ARC bos            -> spec ATLANIR ve atlama rapora ACIK HUCRE yazilir.
#   E2E_ARC=1, factory kodsuz -> BASARISIZ olur. Yanlis yapilandirma atlanacak
#                                bir sey degildir; sessiz bir atlama gecen bir
#                                kosuyla ayni gorunur.
#   E2E_ARC=1, factory canli  -> kosar.
#
# NE OLCER: 0x3600…0000 uzerindeki 6 ondalikli ERC-20 gorunumu ile
# `eth_getBalance`in 18 ondalikli gorunumunun TEK BIR bakiye oldugu
# (`balanceOf * 1e12 === nativeBalance`). Bu iddia anvil'de YAZILAMAZ: orada o
# adreste kontrat yoktur, yani iki gorunumu TOPLAYAN bir arayuz yerel ayakta
# sonsuza kadar yesil kalir.
#
# FONLAMA, OLCULDU: launch + bir alim + bir satis 1 USDC'nin ALTINDA kalir, yani
# tek bir faucet istegi (10 USDC) fazlasiyla yeter. Curve'u TAMAMLAMAK
# 12.313451 USDC + gas ister -- iki faucet istegi -- ve o senaryo
# `E2E_ARC_COMPLETE=1` ile ayrica acilir. Varsayilan kosuda YOKTUR ve sebebi
# kayitlidir: bir faucet hiz siniri bir CI kapisina baglanamaz.
E2E_ARC=
E2E_ARC_RPC_URL=
# Calisan bir arayuz. Deploy edilmis bir URL ya da yerelde `next start`.
E2E_ARC_BASE_URL=
# FONLU BIR TESTNET ANAHTARI, VE YALNIZCA O. Bu anahtar tarayiciya HIC girmez:
# saglayici sayfaya bir kabuk enjekte eder, her istek `exposeFunction` ile
# Node'a gecer ve imza orada atilir. Aksi halde anahtar bir ekran goruntusunde,
# bir trace'te ve bir HAR dosyasinda olurdu.
E2E_ARC_PRIVATE_KEY=
E2E_ARC_FACTORY=
# Islem yapilacak ACIK bir curve ve onun token'i. Adres defterinden gelir.
E2E_ARC_TOKEN=
E2E_ARC_CURVE=
