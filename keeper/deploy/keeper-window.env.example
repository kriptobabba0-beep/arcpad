# /etc/arcpad/keeper-window.env      root:arcpad 0640
#
# The graduation-window watcher's environment. It holds no key.
#
# NO ADDRESSES HERE EITHER. The watcher reads contracts/deploy/addresses.<chainId>.json
# directly; .env.example says in its own words that ARC_FACTORY_ADDRESS,
# ARC_START_BLOCK and KEEPER_CHAIN_KEY, IF SET, must equal the book or the
# watcher stops by field name. Leaving them unset is the correct configuration,
# and it is why they are absent rather than commented out: a commented-out
# address is a value waiting to be uncommented.

ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# 30000 IS NOT A PREFERENCE. docs/runbooks/graduation-window.md section 6
# carries the measurements: against the public Arc endpoint a 5s interval was
# re-measured clean only after liveness was retied to scan progress, and the
# drill workflow passes this same number because drillObserve's wait is derived
# from it. If the two disagree, the drill declares a live watcher dead.
KEEPER_POLL_INTERVAL_MS=30000

# The file the forwarder reads and the CI drill fetches. Never make it with a
# shell redirect -- PAGE goes to stderr.
KEEPER_ALERT_LOG=/var/lib/arcpad/alerts.log
KEEPER_CURSOR_FILE=/var/lib/arcpad/.cursor
