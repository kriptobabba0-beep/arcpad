# /etc/arcpad/keeper-graduate.env      root:arcpad 0640
#
# The graduation executor's environment. Copy, fill the one blank, install.
#
# ============ THERE ARE NO ADDRESSES IN THIS FILE ============
#
# and there cannot be. The unit runs with `--book-only`, which refuses to start
# if KEEPER_GRADUATE_FACTORY, KEEPER_GRADUATE_LOCKER or
# KEEPER_GRADUATE_START_BLOCK appear here. Every address comes from
# contracts/deploy/addresses.5042002.json, which is committed, derived, and
# checked against the chain at start-up (the locker's factory() immutable must
# equal the factory the book names, or the process refuses to run).
#
# The indexer is the one layer in this repo that takes ARC_FACTORY_ADDRESS from
# the environment, and scripts/integration/env-from-book.ts exists to keep even
# that tied to the book. The keeper never had that weakness; --book-only is what
# stops a deployment from handing it one.

# The public Arc endpoint. This is NOT a TODO(owner): it is a working default
# and it is what every measurement in this repo was taken against. It does
# rate-limit reads hard (docs/runbooks/graduation-window.md section 6 has the
# numbers), so if you have a dedicated endpoint use it -- and re-measure before
# lowering any interval on the strength of it.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# BROADCASTING. This is the point of the unit: with dry run left on, the
# executor would simulate green forever and graduate nothing the moment a
# target is armed. The key comes from the unit's LoadCredentialEncrypted=, not
# from here -- KEEPER_GRADUATE_PRIVATE_KEY must NEVER appear in this file.
KEEPER_DRY_RUN=false

# 15s is the executor's default and is what the loop was measured at
# (5 heartbeats in 75s, ~15.4s spacing, live, 2026-08-09). The executor rations
# itself to ONE eth_getLogs chunk per pass so the indexer keeps its share of
# Arc's budget -- the same C6 decision the window watcher records.
KEEPER_GRADUATE_POLL_INTERVAL_MS=15000

# THE FILE THE FORWARDER READS. Absolute, on a path the unit can write
# (ReadWritePaths). Do NOT produce it with a shell redirect: PAGE lines go to
# stderr and OK/HEARTBEAT to stdout, so `> file` drops exactly the lines that
# matter. The keeper writes all three itself.
KEEPER_GRADUATE_ALERT_LOG=/var/lib/arcpad/graduate.log

# Runtime state, off the deploy tree so a redeploy cannot wipe the cursor.
KEEPER_GRADUATE_CURSOR_FILE=/var/lib/arcpad/.cursor-graduate
KEEPER_GRADUATE_STATE_FILE=/var/lib/arcpad/.graduate-state.json
KEEPER_GRADUATE_LOCK_DIR=/var/lib/arcpad/.graduate-locks
