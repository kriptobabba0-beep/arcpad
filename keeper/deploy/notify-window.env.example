# /etc/arcpad/notify-window.env      root:arcpad 0640
#
# Instance `window` of arcpad-keeper-notify@.service.

KEEPER_NOTIFY_LOG=/var/lib/arcpad/alerts.log
KEEPER_NOTIFY_LABEL=keeper.graduationWindow

# TODO(owner) 3 -- the same page webhook as the executor's instance. One
# on-call rota, one page destination; the `label` field in the payload says
# which component fired.
KEEPER_NOTIFY_PAGE_URL=

# TODO(owner) 4 -- a dead-man's switch of its OWN, distinct from the
# executor's. See the note in notify-graduate.env.example for why sharing one
# switch would let a live executor conceal a dead watcher.
#
# The watcher polls every 30s and emits a heartbeat per completed poll AND per
# scanned chunk while catching up, so a healthy watcher checks in about once a
# minute here too. Grace period: 10 minutes.
#
# MATCH THE PREFIX, NOT THE STATE. A watcher mid-backfill writes
# `state=catching-up` and is alive; the forwarder counts both states, and a
# rule that counted only `state=current` would declare every cold start dead.
KEEPER_NOTIFY_HEARTBEAT_URL=
