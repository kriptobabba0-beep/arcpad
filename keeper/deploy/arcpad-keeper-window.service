; arcpad -- the graduation-WINDOW watcher.
;
; Read-only. It holds no key and broadcasts nothing; KEEPER_DRY_RUN does not
; apply to it (keeper/src/config.ts says so). It is the control that
; docs/runbooks/graduation-window.md is written about, and until this unit
; exists that runbook describes something nobody runs.
;
; Install:  /etc/systemd/system/arcpad-keeper-window.service

[Unit]
Description=arcpad keeper -- graduation-window watcher (read-only)
Documentation=file:///opt/arcpad/docs/runbooks/graduation-window.md
After=network-online.target
Wants=network-online.target

; Same reasoning as the executor: a watcher systemd has given up on is a
; watcher nobody is running, and a blind window is the whole hazard.
StartLimitIntervalSec=0

[Service]
Type=exec
User=arcpad
Group=arcpad
WorkingDirectory=/opt/arcpad/keeper
ExecStart=/usr/bin/env node --import tsx src/index.ts
EnvironmentFile=/etc/arcpad/keeper-window.env

Restart=always
RestartSec=15
TimeoutStopSec=60

; TODO(owner) 2 -- the same unset MemoryMax as the executor, for the same
; reason: not measured on a VPS, and a plausible number from nowhere is what
; this project has repeatedly been bitten by. See arcpad-keeper-graduate.service.
MemoryAccounting=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

ReadWritePaths=/opt/arcpad/keeper
ReadWritePaths=/var/lib/arcpad

[Install]
WantedBy=multi-user.target
