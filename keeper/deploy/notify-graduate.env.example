# /etc/arcpad/notify-graduate.env      root:arcpad 0640
#
# Instance `graduate` of arcpad-keeper-notify@.service.
#
# Both URLs are REQUIRED and the process refuses to start with only one. Rule
# (1) without rule (2) never catches a killed keeper -- a dead process cannot
# page about itself. Rule (2) without rule (1) never delivers a real finding.

KEEPER_NOTIFY_LOG=/var/lib/arcpad/graduate.log
KEEPER_NOTIFY_LABEL=keeper.graduate

# TODO(owner) 3 -- RULE (1): every line starting with `PAGE ` pages the on-call.
# Any provider that accepts an HTTP POST with a JSON body works; the payload is
# {label, kind, at, text} and `text` carries the whole multi-line event. This
# repo does not choose the provider, and the choice does not change any code.
KEEPER_NOTIFY_PAGE_URL=

# TODO(owner) 5 -- RULE (2): no `HEARTBEAT ` for 10 minutes pages the on-call.
# This must be a check-in URL on a hosted dead-man's switch, and it must be a
# DIFFERENT switch from the window watcher's. Pointing both components at one
# switch would let the executor's check-ins keep it green while the watcher was
# dead -- which is the exact confusion keeper/src/alert.ts split the component
# names to prevent, reappearing at the transport layer.
#
# Set the switch's grace period to 10 minutes. The executor emits one heartbeat
# per pass at a 15s interval, and this forwarder coalesces check-ins to at most
# one per KEEPER_NOTIFY_HEARTBEAT_MIN_INTERVAL_MS (default 60000), so a healthy
# executor checks in about once a minute.
KEEPER_NOTIFY_HEARTBEAT_URL=
