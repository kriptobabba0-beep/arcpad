{
  "name": "@arcpad/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./devchain": "./src/devchain.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:abi": "vitest run --config vitest.abi.config.ts",
    "test:chain": "vitest run --config vitest.chain.config.ts"
  },
  "dependencies": {
    "viem": "2.55.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
